enum Fruit { Apple, Banana, Cherry }

globalvar Fruit favorite;
globalvar Number | Team combo;
globalvar Number selector;
globalvar Number counter = 0;

Number pick: (selector > 0) ? 1 : 2;

Boolean ping() {
    counter += 1;
    return true;
}

rule: "P4 types: enum, union, null, cast"
Event.OngoingPlayer
{
    favorite = Fruit.Banana;
    combo = null;
    if (combo == null) {
        BigMessage(EventPlayer(), "combo is null");
    }
    combo = Team.Team2;
    if (combo == Team.Team1) {
        BigMessage(EventPlayer(), "team one");
    }
    selector = <Number>combo;
    selector = (selector > 0) ? 10 : 20;
    BigMessage(EventPlayer(), <"<0>|<1>|<2>", favorite, combo, selector>);
}

rule: "P4 short circuit pure operands"
Event.OngoingPlayer
{
    if (selector > 0 && selector < 100) {
        BigMessage(EventPlayer(), "range ok");
    }
    if (selector == 0 || selector == 1) {
        BigMessage(EventPlayer(), "edge");
    }
    selector = (selector > 0) ? 10 : 20;
    BigMessage(EventPlayer(), <"<0>", selector>);
}

rule: "P4 short circuit actionful operands"
Event.OngoingPlayer
{
    if (ping() && ping()) {
        BigMessage(EventPlayer(), "both pings");
    }
    selector = ping() ? 10 : 20;
    selector = pick;
    BigMessage(EventPlayer(), <"<0>", selector>);
}

rule: "P4 short circuit mixed operands"
Event.OngoingPlayer
{
    if (ping() && selector > 0) {
        BigMessage(EventPlayer(), "mixed and");
    }
    if (selector == 0 || ping()) {
        BigMessage(EventPlayer(), "mixed or");
    }
}
