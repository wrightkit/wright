globalvar Number counter = 0;

Number twice(Number v): v * 2;

void bump(Number by) {
    counter += by;
}

void bumpDefault(Number by = 5) {
    counter += by;
}

rule: "P5 functions, control flow, switch, return"
Event.OngoingPlayer
{
    counter = twice(3);
    bump(4);
    bumpDefault();
    bumpDefault(1);
    if (counter == 0) {
        return;
    }
    for (counter = 0; counter < 5; 1) {
        bump(1);
        Wait(0.1);
    }
    foreach (Number k in [1, 2, 3]) {
        counter += k;
    }
    switch (counter) {
        case 1:
            bump(10);
        case 2:
            bump(20);
            break;
        case 3:
            bump(30);
        default:
            bump(40);
    }
    counter = twice(counter);
    BigMessage(EventPlayer(), <"<0>", counter>);
}
