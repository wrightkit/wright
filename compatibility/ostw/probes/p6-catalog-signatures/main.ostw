globalvar Number hudText = 0;
globalvar Boolean toggle = false;
globalvar Number counter = 0;

void userCall(
    in Number A = 1,
    in Number B = 2,
    in Number C = 3
) {
    counter += A + B + C;
}

rule: "P6 named arguments against catalog signatures"
Event.OngoingPlayer
{
    toggle = WorkshopSettingToggle(
        SortOrder:      5,
        Default:        true,
        Category:       "6. Interface",
        Name:           "Highlight hovered hero (4 texts)"
    );
    CreateInWorldText(
        VisibleTo:      AllPlayers(),
        Header:         <"<0>", toggle>,
        Position:       Vector(0, 0, 0),
        Clipping:       Clipping.DoNotClip,
        Scale:          3,
        Reevaluation:   InworldTextRev.VisibleToAndString,
        Spectators:     Spectators.VisibleAlways
    );
    hudText = LastTextID();
    BigMessage(Header: <"<0>", toggle>);
    StartCamera(
        Player:         EventPlayer(),
        EyePosition:    Vector(0, 0, 0),
        LookAtPosition: Vector(1, 0, 0)
    );
    userCall(C: 9, A: 1);
    if (IsButtonHeld(Button: Button.Ability2)) {
        Wait(0.05, WaitBehavior.AbortWhenFalse);
    }
    SetInvisible(InvisibleTo: InvisibleTo.All);
    CreateHudText(
        VisibleTo:      toggle ? AllPlayers() : null,
        Header:         "banned",
        Location:       Location.Left,
        SortOrder:      1,
        HeaderColor:    Color.Red,
        Reevaluation:   HudTextRev.VisibleTo,
        Spectators:     Spectators.VisibleAlways
    );
    SmallMessage(EventPlayer(), "p6 done");
    BigMessage(AllPlayers(), <"<0>|<1>", hudText, counter>);
}
