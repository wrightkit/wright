globalvar Number i 127;
globalvar Number j 127;

playervar Number p1 3;
playervar Number p2 3;

rule: "P3b duplicate explicit ids"
Event.OngoingPlayer
{
    i += 1;
    j += 1;
    EventPlayer().p1 = i;
    EventPlayer().p2 = j;
    BigMessage(EventPlayer(), <"<0>|<1>", EventPlayer().p1, EventPlayer().p2>);
}
