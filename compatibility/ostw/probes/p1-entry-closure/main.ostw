import "sub/a.ostw";

globalvar Number rootMarker = 1;

rule: "P1 root rule no event"
{
    rootMarker += 1;
    BigMessage(AllPlayers(), "root no event");
}

rule: "P1 root rule priority minus one" -1
{
    BigMessage(AllPlayers(), "root priority -1");
}

rule: "P1 root rule priority plus two" 2
{
    BigMessage(AllPlayers(), "root priority +2");
}
