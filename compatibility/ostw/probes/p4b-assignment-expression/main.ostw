globalvar Number selector = 0;

rule: "P4b assignment expression in condition"
Event.OngoingPlayer
{
    if ((selector += 1) > 0 && (selector += 1) > 0) {
        BigMessage(EventPlayer(), "assignment operands");
    }
    selector = 1;
    if ((selector = 2) == 2) {
        BigMessage(EventPlayer(), "plain assignment expression");
    }
    BigMessage(EventPlayer(), <"<0>", selector>);
}
