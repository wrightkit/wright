rules:
  rule "control flow" (id 0) @0:3:1-3:6
    event Global
    forGlobalVariable index in 0, 3, 1 @0:5:5-5:9
      if @0:6:9-6:12
        condition ==(index, 0)
          call createHudText(allPlayers(Team.ALL), null, customString("{0}", index), null, HudPosition.LEFT, -9999, Color.WHITE, Color.WHITE, Color.WHITE, HudReeval.VISIBILITY_AND_STRING, SpecVisibility.DEFAULT) @0:7:13-7:26
        elif condition ==(index, 1)
          call createHudText(allPlayers(Team.ALL), null, customString("{0}", index), null, HudPosition.LEFT, -9999, Color.WHITE, Color.WHITE, Color.WHITE, HudReeval.VISIBILITY_AND_STRING, SpecVisibility.DEFAULT) @0:9:13-9:26
        else
          call createHudText(allPlayers(Team.ALL), null, customString("{0}", index), null, HudPosition.LEFT, -9999, Color.WHITE, Color.WHITE, Color.WHITE, HudReeval.VISIBILITY_AND_STRING, SpecVisibility.DEFAULT) @0:11:13-11:26
  rule "bounded while" (id 1) @0:13:1-13:6
    event Global
    while <(index, 3) @0:15:5-15:11
      modifyGlobalVariable index Add 1 @0:16:9-16:20
      call wait(0.016, Wait.IGNORE_CONDITION) @0:17:9-17:16
