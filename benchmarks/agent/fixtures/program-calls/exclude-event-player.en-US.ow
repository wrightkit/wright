rule ("Array removal") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    actions {
        Small Message(Remove From Array(All Living Players(Team 2), Event Player), Custom String("Other players"));
    }
}

rule ("Filter") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    actions {
        Small Message(Filtered Array(All Living Players(Team 2), Current Array Element != Event Player), Custom String("Other players"));
    }
}

rule ("Reversed filter") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    actions {
        Small Message(Filtered Array(All Living Players(Team 2), Event Player != Current Array Element), Custom String("Other players"));
    }
}
