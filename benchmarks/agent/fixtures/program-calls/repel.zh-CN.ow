变量 {
    玩家:
        0: other
}

规则 ("Proximity repel") {
    事件 {
        持续 - 每名玩家;
        双方;
        全部;
    }
    条件 {
        相距距离(事件玩家, (事件玩家).other) <= 6;
    }
    动作 {
        施加推力(事件玩家, 方向((事件玩家).other, 事件玩家), 150, 至地图, 取消相反运动XYZ);
        施加推力((事件玩家).other, 方向(事件玩家, (事件玩家).other), 150, 至地图, 取消相反运动XYZ);
        设置状态(事件玩家, 空, 击晕, 0.75);
        设置状态((事件玩家).other, 空, 击晕, 0.75);
    }
}

