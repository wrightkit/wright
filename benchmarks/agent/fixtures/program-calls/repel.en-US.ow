variables {
    player:
        0: other
}

rule ("Proximity repel") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Distance Between(Event Player, (Event Player).other) <= 6;
    }
    actions {
        Apply Impulse(Event Player, Direction Towards((Event Player).other, Event Player), 150, To World, Cancel Contrary Motion XYZ);
        Apply Impulse((Event Player).other, Direction Towards(Event Player, (Event Player).other), 150, To World, Cancel Contrary Motion XYZ);
        Set Status(Event Player, Null, Stunned, 0.75);
        Set Status((Event Player).other, Null, Stunned, 0.75);
    }
}

