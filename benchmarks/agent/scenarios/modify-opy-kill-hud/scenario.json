{
  "id": "modify-opy-kill-hud",
  "family": "modification",
  "language": "opy",
  "entry": "mode.opy",
  "split": "test",
  "writable": [
    "mode.opy"
  ],
  "runtimeOnly": [
    "The HUD text updates and renders as intended in a live match."
  ],
  "checks": [
    {
      "id": "valid-project",
      "kind": "check",
      "layer": "opy-rs"
    },
    {
      "id": "upstream-valid",
      "kind": "oracle",
      "layer": "agent"
    },
    {
      "id": "wright-compiles",
      "kind": "wright-compile",
      "layer": "opy-rs"
    },
    {
      "id": "hud-shows-own-eliminations",
      "kind": "compiled-contains",
      "layer": "agent",
      "all": [
        "Create HUD Text\\((Event Player|All Players)[^;]*(\\(Event Player\\)|Event Player)\\.\\w*kills"
      ]
    },
    {
      "id": "rules-preserved",
      "kind": "compiled-contains",
      "layer": "agent",
      "all": [
        "rule \\(\"force heroes\"\\)",
        "rule \\(\"count kill\"\\)",
        "rule \\(\"restore health\"\\)",
        "rule \\(\"declare winner\"\\)"
      ]
    },
    {
      "id": "target-unchanged",
      "kind": "compiled-contains",
      "layer": "agent",
      "all": [
        ">= 5"
      ]
    },
    {
      "id": "health-rule-preserved",
      "kind": "compiled-contains",
      "layer": "agent",
      "all": [
        "Heal\\("
      ]
    }
  ],
  "negatives": {
    "no-hud": {
      "fails": [
        "hud-shows-own-eliminations"
      ]
    },
    "drops-a-rule": {
      "fails": [
        "health-rule-preserved",
        "rules-preserved"
      ]
    },
    "changes-the-target": {
      "fails": [
        "target-unchanged"
      ]
    }
  }
}
