{
  "contract": "wright-agent-metrics-corpus/v1",
  "version": "v1",
  "projects": [
    {
      "id": "small-workshop",
      "kind": "workshop",
      "path": "corpus/small-workshop",
      "entry": "main.ws"
    },
    {
      "id": "seed-modify-target-score",
      "kind": "workshop",
      "path": "corpus/seed-modify-target-score",
      "entry": "mode.ws",
      "scenarios": ["modify"]
    },
    {
      "id": "seed-repair-runaway-loop",
      "kind": "workshop",
      "path": "corpus/seed-repair-runaway-loop",
      "entry": "mode.ws",
      "scenarios": ["repair"]
    },
    {
      "id": "seed-understand-score-flow",
      "kind": "workshop",
      "path": "corpus/seed-understand-score-flow",
      "entry": "mode.ws",
      "scenarios": ["understand"]
    },
    {
      "id": "seed-modify-opy-project",
      "kind": "opy",
      "path": "corpus/seed-modify-opy-project",
      "entry": "mode.opy",
      "scenarios": ["modify"]
    },
    {
      "id": "seed-repair-opy-runaway-loop",
      "kind": "opy",
      "path": "corpus/seed-repair-opy-runaway-loop",
      "entry": "mode.opy",
      "scenarios": ["repair"]
    },
    {
      "id": "seed-understand-opy-project",
      "kind": "opy",
      "path": "corpus/seed-understand-opy-project",
      "entry": "mode.opy",
      "scenarios": ["understand"]
    },
    {
      "id": "bastion",
      "kind": "opy",
      "repository": "https://github.com/OWBastion/Bastion.git",
      "commit": "6b930ab132f8f8eb7aca7d4db081c65e5b937237",
      "entry": "src/main.opy",
      "scenarios": ["understand", "modify", "repair"]
    },
    {
      "id": "overwatch-ai-pve",
      "kind": "opy",
      "repository": "https://github.com/Teakowa/Overwatch-AI-PVE.git",
      "commit": "2a2f115b508d3b1d50dff00d629cc41661c1ff69",
      "entry": "src/main.opy",
      "scenarios": ["understand", "modify", "repair"]
    }
  ],
  "scenarios": [
    {
      "id": "understand",
      "source": "agent-guide/wright/SKILL.md:13,15 (correctness; what does this symbol or rule do)",
      "steps": [
        ["check"],
        ["inspect", "symbols"],
        ["inspect", "rules"],
        ["inspect", "refs", "{symbol}"]
      ]
    },
    {
      "id": "modify",
      "source": "agent-guide/wright/SKILL.md:13-15,21 (check/lint/analyze before and after a change; what breaks if I change it; baseline before editing, compare after)",
      "steps": [
        ["check"],
        ["lint"],
        ["analyze"],
        ["inspect", "refs", "{symbol}"],
        ["check"],
        ["lint"],
        ["analyze"]
      ]
    },
    {
      "id": "repair",
      "source": "agent-guide/wright/SKILL.md:13-15,21 (check/lint/analyze; inspect the rule; compare after the fix)",
      "steps": [
        ["check"],
        ["lint"],
        ["analyze"],
        ["inspect", "cfg", "{rule}"],
        ["check"],
        ["lint"]
      ]
    }
  ]
}
