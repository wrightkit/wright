    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
