{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrightkit.dev/schemas/wright-agent-v1.schema.json",
  "title": "Wright agent contract v1",
  "$defs": {
    "ToolRequest": {
      "oneOf": [
        { "$ref": "#/$defs/CapabilitiesRequest" },
        { "$ref": "#/$defs/CompileRequest" },
        { "$ref": "#/$defs/CheckRequest" },
        { "$ref": "#/$defs/AnalyzeRequest" },
        { "$ref": "#/$defs/InspectRequest" },
        { "$ref": "#/$defs/ProjectRequest" },
        { "$ref": "#/$defs/RulesRequest" },
        { "$ref": "#/$defs/SymbolsRequest" },
        { "$ref": "#/$defs/ReferencesRequest" },
        { "$ref": "#/$defs/UsageRequest" },
        { "$ref": "#/$defs/CfgRequest" },
        { "$ref": "#/$defs/FindingsRequest" },
        { "$ref": "#/$defs/PersistentObjectsRequest" },
        { "$ref": "#/$defs/LintRequest" },
        { "$ref": "#/$defs/LintRulesRequest" },
        { "$ref": "#/$defs/CallGraphRequest" },
        { "$ref": "#/$defs/CostEstimateRequest" },
        { "$ref": "#/$defs/TargetMetadataRequest" },
        { "$ref": "#/$defs/ValidateEditTransactionRequest" },
        { "$ref": "#/$defs/SemanticRenameRequest" },
        { "$ref": "#/$defs/ProviderSemanticRenameRequest" },
        { "$ref": "#/$defs/ProviderValidateEditRequest" },
        { "$ref": "#/$defs/LookupRequest" }
      ]
    },
    "ToolResponse": {
      "oneOf": [
        {
          "type": "object",
          "required": ["result"],
          "properties": { "result": { "$ref": "#/$defs/AgentResult" } },
          "not": { "required": ["error"] },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["error"],
          "properties": { "error": { "$ref": "#/$defs/ToolErrorInfo" } },
          "not": { "required": ["result"] },
          "additionalProperties": true
        }
      ]
    },
    "ToolErrorInfo": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable refusal code. `stale-id` reports a numeric symbol id or rule index issued by an earlier program: after the loaded project changed on disk, the id must be re-read from a fresh `symbols`/`rules` listing or replaced by the declared name."
        },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "AgentResult": {
      "anyOf": [
        { "$ref": "#/$defs/Capabilities" },
        { "$ref": "#/$defs/CompileResult" },
        { "$ref": "#/$defs/CheckResult" },
        { "$ref": "#/$defs/AnalyzeResult" },
        { "$ref": "#/$defs/InspectResult" },
        { "$ref": "#/$defs/ProjectResult" },
        { "$ref": "#/$defs/RulesResult" },
        { "$ref": "#/$defs/SymbolsResult" },
        { "$ref": "#/$defs/ReferencesResult" },
        { "$ref": "#/$defs/UsageResult" },
        { "$ref": "#/$defs/CfgResult" },
        { "$ref": "#/$defs/FindingsResult" },
        { "$ref": "#/$defs/PersistentObjectsResult" },
        { "$ref": "#/$defs/LintResult" },
        { "$ref": "#/$defs/LintRulesResult" },
        { "$ref": "#/$defs/CallGraphResult" },
        { "$ref": "#/$defs/CostEstimateResult" },
        { "$ref": "#/$defs/TargetMetadataResult" },
        { "$ref": "#/$defs/ValidateEditTransactionResult" },
        { "$ref": "#/$defs/SemanticRenameResult" },
        { "$ref": "#/$defs/ProviderSemanticRenameResult" },
        { "$ref": "#/$defs/ProviderValidateEditResult" },
        { "$ref": "#/$defs/LookupResult" }
      ]
    },
    "WorkflowEnvelope": {
      "type": "object",
      "required": ["wright", "command", "ok", "exit", "diagnostics", "result"],
      "properties": {
        "wright": { "$ref": "#/$defs/ResultContract" },
        "command": { "type": "string" },
        "ok": { "type": "boolean" },
        "exit": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
        "result": { "type": "object" }
      },
      "additionalProperties": true
    },
    "ResultContract": {
      "type": "object",
      "required": ["version", "contract"],
      "properties": {
        "version": { "type": "string" },
        "contract": { "const": "wright-result/v1" }
      },
      "additionalProperties": true
    },
    "Diagnostic": {
      "type": "object",
      "required": ["code", "stage", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "stage": { "enum": ["discovery", "frontend", "lowering", "validation", "emission", "analysis", "reconstruction", "internal"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "status": { "enum": ["supported", "partial", "unsupported"] },
        "span": { "$ref": "#/$defs/SourceSpan" },
        "source": { "$ref": "#/$defs/Origin" }
      },
      "additionalProperties": true
    },
    "Position1Based": {
      "type": "object",
      "required": ["line", "col"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "Origin": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "locale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "SourceSpan": {
      "type": "object",
      "required": ["file", "start", "end"],
      "properties": {
        "file": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "start": { "$ref": "#/$defs/Position1Based" },
        "end": { "$ref": "#/$defs/Position1Based" }
      },
      "additionalProperties": true
    },
    "Span": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/SourceSpan" }
      ]
    },
    "ProgramSummary": {
      "type": "object",
      "required": ["origin", "files", "globalVariables", "playerVariables", "subroutines", "rules", "findings"],
      "properties": {
        "origin": { "$ref": "#/$defs/Origin" },
        "files": { "type": "integer", "minimum": 0 },
        "globalVariables": { "type": "integer", "minimum": 0 },
        "playerVariables": { "type": "integer", "minimum": 0 },
        "subroutines": { "type": "integer", "minimum": 0 },
        "rules": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "AnalyzedProgramSummary": {
      "type": "object",
      "required": ["origin", "files", "globalVariables", "playerVariables", "subroutines", "rules"],
      "properties": {
        "origin": { "$ref": "#/$defs/Origin" },
        "files": { "type": "integer", "minimum": 0 },
        "globalVariables": { "type": "integer", "minimum": 0 },
        "playerVariables": { "type": "integer", "minimum": 0 },
        "subroutines": { "type": "integer", "minimum": 0 },
        "rules": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "RuleSummary": {
      "type": "object",
      "required": ["id", "name", "span"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "span": { "$ref": "#/$defs/Span" }
      },
      "additionalProperties": true
    },
    "Symbol": {
      "type": "object",
      "required": ["id", "kind", "name", "span"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "span": { "$ref": "#/$defs/Span" }
      },
      "additionalProperties": true
    },
    "Reference": {
      "type": "object",
      "required": ["kind", "span", "rule", "action", "value"],
      "properties": {
        "kind": { "enum": ["declaration", "definition", "read", "write", "call"] },
        "span": { "$ref": "#/$defs/Span" },
        "rule": { "type": ["integer", "null"], "minimum": 0 },
        "action": { "type": ["integer", "null"], "minimum": 0 },
        "value": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "Finding": {
      "type": "object",
      "required": ["code", "severity", "message", "span", "rule", "action", "value", "evidence", "boundedness"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "span": { "$ref": "#/$defs/Span" },
        "rule": { "type": ["integer", "null"], "minimum": 0 },
        "action": { "type": ["integer", "null"], "minimum": 0 },
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "evidence": { "type": "string" },
        "boundedness": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "LintRule": {
      "type": "object",
      "required": ["id", "defaultSeverity", "effectiveSeverity", "enabled", "summary", "rationale", "documentation", "knownLimits", "evidence", "tags", "kind"],
      "properties": {
        "id": { "type": "string" },
        "defaultSeverity": { "type": "string" },
        "effectiveSeverity": { "type": "string" },
        "enabled": { "type": "boolean" },
        "summary": { "type": "string" },
        "rationale": { "type": "string" },
        "documentation": { "type": "string" },
        "knownLimits": { "type": "string" },
        "evidence": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "LintRuleSummary": {
      "type": "object",
      "required": ["id", "effectiveSeverity"],
      "properties": {
        "id": { "type": "string" },
        "effectiveSeverity": { "type": "string" }
      },
      "additionalProperties": true
    },
    "LintConfiguration": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": { "type": "object", "additionalProperties": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "SkippedRule": {
      "type": "object",
      "required": ["id", "rule", "reason"],
      "properties": {
        "id": { "type": "string" },
        "rule": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "SourcePreview": {
      "type": "object",
      "required": ["source", "source_identity", "new_text"],
      "properties": {
        "source": { "type": "string" },
        "source_identity": { "type": "string" },
        "new_text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "EditValidationPayload": {
      "type": "object",
      "required": ["ok", "exit", "diagnostics"],
      "properties": {
        "ok": { "type": "boolean" },
        "exit": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
        "preview": { "type": "array", "items": { "$ref": "#/$defs/SourcePreview" } }
      },
      "additionalProperties": true
    },
    "SemanticRenamePayload": {
      "type": "object",
      "required": ["ok", "transaction", "diagnostics"],
      "properties": {
        "ok": { "type": "boolean" },
        "transaction": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/EditTransaction" }] },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
        "preview": { "type": "array", "items": { "$ref": "#/$defs/SourcePreview" } }
      },
      "additionalProperties": true
    },
    "ProviderMutationPayload": {
      "type": "object",
      "required": ["ok", "diagnostics"],
      "properties": {
        "ok": { "type": "boolean" },
        "transaction": { "$ref": "#/$defs/EditTransaction" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
        "preview": { "type": "array", "items": { "$ref": "#/$defs/SourcePreview" } },
        "provider_code": { "type": "string" },
        "provider_message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "CapabilitiesResult": { "$ref": "#/$defs/Capabilities" },
    "CompileResult": {
      "allOf": [
        { "$ref": "#/$defs/WorkflowEnvelope" },
        { "type": "object", "properties": { "command": { "const": "compile" }, "result": { "$ref": "#/$defs/CompilePayload" } } }
      ]
    },
    "CheckResult": {
      "allOf": [
        { "$ref": "#/$defs/WorkflowEnvelope" },
        { "type": "object", "properties": { "command": { "const": "check" }, "result": { "$ref": "#/$defs/CheckPayload" } } }
      ]
    },
    "AnalyzeResult": {
      "allOf": [
        { "$ref": "#/$defs/WorkflowEnvelope" },
        { "type": "object", "properties": { "command": { "const": "analyze" }, "result": { "anyOf": [{ "$ref": "#/$defs/AnalyzePayload" }, { "$ref": "#/$defs/BriefResult" }] } } }
      ]
    },
    "InspectResult": {
      "allOf": [
        { "$ref": "#/$defs/WorkflowEnvelope" },
        { "type": "object", "properties": { "command": { "const": "inspect" }, "result": { "anyOf": [{ "$ref": "#/$defs/InspectPayload" }, { "$ref": "#/$defs/BriefResult" }] } } }
      ]
    },
    "ProjectResult": {
      "type": "object",
      "required": ["origin", "inputIdentity", "files", "globalVariables", "playerVariables", "subroutines", "rules", "symbols", "findings"],
      "properties": {
        "origin": { "$ref": "#/$defs/Origin" },
        "inputIdentity": { "type": "string", "description": "SHA-256 hex digest of the input's primary entry source (the provider's `sourceIdentity` for provider projects). For a single-file input it covers the whole input; for a provider directory project it hashes only the entry file, so member-file edits do not change it — use `stale-id` refusals for freshness, not this value." },
        "files": { "type": "integer", "minimum": 0 },
        "globalVariables": { "type": "integer", "minimum": 0 },
        "playerVariables": { "type": "integer", "minimum": 0 },
        "subroutines": { "type": "integer", "minimum": 0 },
        "rules": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "RulesResult": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/RuleSummary" } },
        { "$ref": "#/$defs/RulesSelectionResult" }
      ]
    },
    "RulesSelectionResult": {
      "type": "object",
      "required": ["rules", "selection"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/RuleSummary" } },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "SymbolsResult": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/Symbol" } },
        { "$ref": "#/$defs/SymbolsSelectionResult" }
      ]
    },
    "SymbolsSelectionResult": {
      "type": "object",
      "required": ["symbols", "selection"],
      "properties": {
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/Symbol" } },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "ReferencesResult": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/Reference" } },
        { "$ref": "#/$defs/ReferencesSelectionResult" }
      ]
    },
    "ReferencesSelectionResult": {
      "type": "object",
      "required": ["references", "selection"],
      "properties": {
        "references": { "type": "array", "items": { "$ref": "#/$defs/Reference" } },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "UsageResult": {
      "type": "object",
      "required": ["id", "kind", "symbol", "reads", "writes", "calls", "rules"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "symbol": { "type": "string" },
        "reads": { "type": "integer", "minimum": 0 },
        "writes": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "rules": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "CfgResult": {
      "type": "object",
      "required": ["entry", "exit", "blocks"],
      "properties": {
        "entry": { "type": "integer", "minimum": 0 },
        "exit": { "type": "integer", "minimum": 0 },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "waits", "calls", "actions", "successors"],
            "properties": {
              "id": { "type": "integer", "minimum": 0 },
              "kind": { "type": "string" },
              "waits": { "type": "boolean" },
              "calls": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "actions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "successors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["to", "kind"],
                  "properties": { "to": { "type": "integer", "minimum": 0 }, "kind": { "type": "string" } },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "SelectionSummary": {
      "type": "object",
      "required": ["total", "withheld"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "withheld": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "FindingsResult": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        { "$ref": "#/$defs/FindingsSelectionResult" }
      ]
    },
    "FindingsSelectionResult": {
      "type": "object",
      "required": ["findings", "selection"],
      "properties": {
        "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "PersistentObjectsResult": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "rule", "action", "executionScope", "visibility", "reevaluation", "identityRetained", "sameKindCleanupInRule", "span"],
        "properties": {
          "kind": { "type": "string" },
          "rule": { "type": "integer", "minimum": 0 },
          "action": { "type": "integer", "minimum": 0 },
          "executionScope": { "type": "string" },
          "visibility": { "type": "string" },
          "reevaluation": { "anyOf": [{ "type": "null" }, { "type": "object", "required": ["domain", "mode"], "properties": { "domain": { "type": "string" }, "mode": { "type": "string" } }, "additionalProperties": true }] },
          "identityRetained": { "type": "boolean" },
          "sameKindCleanupInRule": { "type": "boolean" },
          "span": { "$ref": "#/$defs/Span" }
        },
        "additionalProperties": true
      }
    },
    "LintResult": {
      "anyOf": [
        { "$ref": "#/$defs/LintPayload" },
        { "$ref": "#/$defs/BriefResult" }
      ]
    },
    "LintPayload": {
      "type": "object",
      "required": ["inputIdentity", "rules", "config", "findings", "skipped"],
      "properties": {
        "inputIdentity": { "type": "string", "description": "The loaded input's primary entry source digest — same semantics as `project.inputIdentity`; member-file edits in a provider project do not change it." },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/LintRuleSummary" } },
        "config": { "$ref": "#/$defs/LintConfiguration" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/SkippedRule" } },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "BriefResult": {
      "type": "object",
      "required": ["brief", "counts", "items", "expand"],
      "properties": {
        "brief": { "const": true },
        "program": { "type": "object", "additionalProperties": true },
        "counts": { "type": "object", "additionalProperties": true },
        "items": { "type": "array" },
        "expand": { "type": "string" },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "LintRulesResult": {
      "type": "object",
      "required": ["rules", "config", "skipped"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/LintRule" } },
        "config": { "$ref": "#/$defs/LintConfiguration" },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/SkippedRule" } }
      },
      "additionalProperties": true
    },
    "CallGraphEdge": {
      "type": "object",
      "required": ["caller", "callee"],
      "properties": { "caller": { "type": "string" }, "callee": { "type": "string" } },
      "additionalProperties": true
    },
    "CallGraphResult": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/CallGraphEdge" } },
        { "$ref": "#/$defs/CallGraphSelectionResult" }
      ]
    },
    "CallGraphSelectionResult": {
      "type": "object",
      "required": ["edges", "selection"],
      "properties": {
        "edges": { "type": "array", "items": { "$ref": "#/$defs/CallGraphEdge" } },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "CostEstimateResult": {
      "type": "object",
      "required": ["exact", "findings", "kind"],
      "properties": {
        "exact": {
          "type": "object",
          "required": ["emittedBytes", "programActions", "programRules", "waitActions"],
          "properties": {
            "emittedBytes": { "type": "integer", "minimum": 0 },
            "programActions": { "type": "integer", "minimum": 0 },
            "programRules": { "type": "integer", "minimum": 0 },
            "waitActions": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "findings": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message"], "properties": { "code": { "type": "string" }, "severity": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": true } },
        "kind": { "type": "object", "required": ["exact", "findings", "performance"], "properties": { "exact": { "type": "string" }, "findings": { "type": "string" }, "performance": { "type": "string" } }, "additionalProperties": true },
        "selection": { "$ref": "#/$defs/SelectionSummary" }
      },
      "additionalProperties": true
    },
    "TargetMetadataResult": {
      "type": "object",
      "required": ["catalogVersion", "locales", "actions", "values", "events", "operators", "enumDomains"],
      "properties": {
        "catalogVersion": { "type": "string" },
        "locales": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "integer", "minimum": 0 },
        "values": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 },
        "operators": { "type": "integer", "minimum": 0 },
        "enumDomains": { "type": "array", "items": { "type": "object", "required": ["domain", "members"], "properties": { "domain": { "type": "string" }, "members": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "ValidateEditTransactionResult": { "$ref": "#/$defs/EditValidationPayload" },
    "SemanticRenameResult": { "$ref": "#/$defs/SemanticRenamePayload" },
    "ProviderSemanticRenameResult": { "$ref": "#/$defs/ProviderMutationPayload" },
    "ProviderValidateEditResult": { "$ref": "#/$defs/ProviderMutationPayload" },
    "LookupEntry": {
      "type": "object",
      "required": ["identity", "kind", "spelling", "displayName"],
      "properties": {
        "identity": { "type": "string" },
        "kind": { "type": "string" },
        "spelling": { "type": "string" },
        "displayName": { "type": "string" },
        "signature": { "type": "string" },
        "callable": { "type": "object" },
        "enum": { "type": "object" },
        "parameter": { "type": "object" },
        "setting": { "type": "object" }
      },
      "additionalProperties": true
    },
    "LookupResult": {
      "type": "object",
      "required": ["language", "owner", "entries"],
      "properties": {
        "language": { "type": "string" },
        "owner": { "type": "string" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/LookupEntry" }
        },
        "unavailable": {
          "type": "object",
          "required": ["capability", "message"],
          "properties": {
            "capability": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "CompilePayload": {
      "type": "object",
      "properties": {
        "output": {
          "type": "object",
          "required": ["text", "sha256", "locale", "written_to", "input_identity"],
          "properties": {
            "text": { "type": "string" },
            "sha256": { "type": "string" },
            "locale": { "type": "string" },
            "written_to": { "type": "string" },
            "input_identity": { "type": "string", "description": "The loaded input's primary entry source digest — same semantics as `project.inputIdentity`." }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "CheckPayload": { "type": "object", "additionalProperties": true },
    "AnalyzePayload": {
      "type": "object",
      "required": ["program", "facts"],
      "properties": {
        "program": { "$ref": "#/$defs/AnalyzedProgramSummary" },
        "facts": {
          "type": "object",
          "required": ["symbols", "rules", "persistentObjects"],
          "properties": {
            "symbols": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "name", "span", "usage"],
                "properties": {
                  "id": { "type": "integer", "minimum": 0 },
                  "kind": { "type": "string" },
                  "name": { "type": "string" },
                  "span": { "$ref": "#/$defs/Span" },
                  "usage": { "$ref": "#/$defs/UsageResult" }
                },
                "additionalProperties": true
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "span", "controlFlow"],
                "properties": {
                  "id": { "type": "integer", "minimum": 0 },
                  "name": { "type": "string" },
                  "span": { "$ref": "#/$defs/Span" },
                  "controlFlow": {
                    "type": "object",
                    "required": ["blocks", "edges", "loopBlocks", "waitBlocks"],
                    "properties": {
                      "blocks": { "type": "integer", "minimum": 0 },
                      "edges": { "type": "integer", "minimum": 0 },
                      "loopBlocks": { "type": "integer", "minimum": 0 },
                      "waitBlocks": { "type": "integer", "minimum": 0 }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            },
            "persistentObjects": { "$ref": "#/$defs/PersistentObjectsResult" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "InspectPayload": {
      "type": "object",
      "required": ["program", "rules", "symbols", "references"],
      "properties": {
        "program": { "$ref": "#/$defs/ProgramSummary" },
        "rules": { "$ref": "#/$defs/RulesResult" },
        "symbols": { "$ref": "#/$defs/SymbolsResult" },
        "references": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/Reference" } } }
      },
      "additionalProperties": true
    },
    "Capabilities": {
      "type": "object",
      "required": ["name", "version", "contract", "agent_contract", "operations", "result_schemas", "languages", "profiles"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "contract": { "const": "wright-result/v1" },
        "agent_contract": { "const": "wright-agent/v1" },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "result_schemas": {
          "type": "object",
          "description": "The committed-schema definition describing each advertised operation's result (#532): operation name to its `#/$defs/<Op>Result` reference.",
          "additionalProperties": { "type": "string" }
        },
        "languages": { "type": "array", "items": { "type": "string" } },
        "profiles": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "Sources": {
      "type": "object",
      "description": "Source name → full current text. On `validateEditTransaction`/`semanticRename` the key is the loaded input's source spelling and the field may be omitted (the service reads the named files from disk, #472). On `providerValidateEdit` the keys are `documents` URIs covering every `edits[].source`; on `providerSemanticRename` they cover every document the provider's computed rename may edit — an edit into an unsupplied source refuses `edit-unknown-source`. The text is the precondition each edit's `source_identity` verifies against and the text edits apply to.",
      "additionalProperties": { "type": "string" }
    },
    "EditRange": {
      "type": "object",
      "description": "A half-open source range in 1-based lines and character columns; `end` is exclusive and a column may point one past the line's last character. A zero-width range inserts `new_text`.",
      "required": ["start_line", "start_col", "end_line", "end_col"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "start_col": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "end_line": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "end_col": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "SourceEdit": {
      "type": "object",
      "required": ["kind", "source", "source_identity", "range", "new_text"],
      "properties": {
        "kind": { "type": "string", "description": "The edit kind: `edit` for a caller-proposed replacement; other kinds such as `rename` appear only on service-computed results." },
        "source": { "type": "string", "description": "The source this edit applies to: the loaded input's spelling on `validateEditTransaction`, or a `documents` URI key on the provider operations." },
        "source_identity": { "type": "string", "description": "The SHA-256 hex digest of the source's current text — the same digest `project.inputIdentity` reports for the entry source; a text that hashes differently refuses `edit-stale-source`." },
        "range": { "$ref": "#/$defs/EditRange" },
        "new_text": { "type": "string", "description": "The replacement text; empty deletes the range." }
      },
      "additionalProperties": false
    },
    "EditTransaction": {
      "type": "object",
      "required": ["edits"],
      "properties": {
        "edits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceEdit" }, "description": "The transaction's edits, applied atomically; edits in one source must not overlap, and two zero-width edits at the same position refuse `edit-zero-width-conflict`." }
      },
      "additionalProperties": false
    },
    "RenameTarget": {
      "type": "object",
      "required": ["to"],
      "properties": {
        "symbol": {
          "type": ["integer", "string"],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Symbol addressing (#434): the numeric symbol id or the declared name, exactly as `references`/`usage` address symbols. When present, `source`/`line`/`col` are ignored. A numeric id issued before a disk reload is refused `stale-id` until a `symbols` listing re-establishes the space."
        },
        "source": { "type": "string", "description": "Position addressing: the source file the position is interpreted in; requires `line` and `col`." },
        "line": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Position addressing: the 1-based line of a character inside one identifier occurrence." },
        "col": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Position addressing: the 1-based column of a character inside one identifier occurrence." },
        "to": { "type": "string", "description": "The replacement identifier." }
      },
      "additionalProperties": false
    },
    "Document": {
      "type": "object",
      "required": ["uri", "languageId", "version", "text"],
      "properties": {
        "uri": { "type": "string", "description": "The document's URI — also its key in `documents`; provider edit results address documents by it." },
        "languageId": { "type": "string", "description": "The document's language id (`opy`)." },
        "version": { "type": "integer", "description": "The document's current version; provider-computed edits validated against another version refuse `edit-stale-source`." },
        "text": { "type": "string", "description": "The document's full current text." }
      },
      "additionalProperties": false
    },
    "DocumentSet": {
      "type": "object",
      "description": "URI → `Document` map: the caller-owned project document set the provider operates on. `providerValidateEdit` refuses an `edits[].source` outside the set with `edit-unknown-source`; `providerSemanticRename` requires `position_document_uri` inside the set and refuses provider-returned edits outside it with `provider-edit-outside-set`.",
      "additionalProperties": { "$ref": "#/$defs/Document" }
    },
    "Position": {
      "type": "object",
      "description": "A 0-based line and UTF-16 character offset — the provider convention, unlike `EditRange`'s 1-based columns.",
      "required": ["line", "character"],
      "properties": {
        "line": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "character": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "CapabilitiesRequest": { "type": "object", "properties": { "op": { "const": "capabilities" } }, "required": ["op"], "additionalProperties": false },
    "CompileRequest": { "type": "object", "properties": { "op": { "const": "compile" } }, "required": ["op"], "additionalProperties": false },
    "CheckRequest": { "type": "object", "properties": { "op": { "const": "check" } }, "required": ["op"], "additionalProperties": false },
    "AnalyzeRequest": { "type": "object", "properties": { "op": { "const": "analyze" }, "brief": { "type": "boolean", "default": false } }, "required": ["op"], "additionalProperties": false },
    "InspectRequest": { "type": "object", "properties": { "op": { "const": "inspect" }, "brief": { "type": "boolean", "default": false } }, "required": ["op"], "additionalProperties": false },
    "ProjectRequest": { "type": "object", "properties": { "op": { "const": "project" } }, "required": ["op"], "additionalProperties": false },
    "RulesRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "rules" },
        "name": { "type": "string", "description": "Selection (#531): only the rule with this declared name." },
        "file": { "type": "string", "description": "Selection (#531): only rules located in this source file; any spelling that resolves to the same file selects it." },
        "max": { "type": "integer", "minimum": 0, "description": "Selection (#531): report at most this many rules; the response's `selection.withheld` counts what the bound dropped." }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "SymbolsRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "symbols" },
        "kind": { "enum": ["globalVariable", "playerVariable", "subroutine", "rule", null], "description": "Selection (#531): only symbols of this kind." },
        "file": { "type": "string", "description": "Selection (#531): only symbols located in this source file; any spelling that resolves to the same file selects it." },
        "max": { "type": "integer", "minimum": 0, "description": "Selection (#531): report at most this many symbols; the response's `selection.withheld` counts what the bound dropped." }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "ReferencesRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "references" },
        "symbol": {
          "type": ["integer", "string"],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Symbol id or declared name. A numeric id captured before the project changed on disk is refused `stale-id` until a `symbols` listing re-establishes the space; names are always current."
        },
        "kind": { "enum": ["declaration", "definition", "read", "write", "call"], "description": "Selection (#531): only references of this kind." },
        "rule": {
          "type": ["integer", "string"],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Selection (#531): only references inside this rule, addressed by index or declared name."
        },
        "file": { "type": "string", "description": "Selection (#531): only references located in this source file; any spelling that resolves to the same file selects it." },
        "max": { "type": "integer", "minimum": 0, "description": "Selection (#531): report at most this many references; the response's `selection.withheld` counts what the bound dropped." }
      },
      "required": ["op", "symbol"],
      "additionalProperties": false
    },
    "UsageRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "usage" },
        "symbol": {
          "type": ["integer", "string"],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Symbol id or declared name. A numeric id captured before the project changed on disk is refused `stale-id` until a `symbols` listing re-establishes the space; names are always current."
        }
      },
      "required": ["op", "symbol"],
      "additionalProperties": false
    },
    "CfgRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "cfg" },
        "rule": {
          "type": ["integer", "string"],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Rule index or declared name. A numeric index captured before the project changed on disk is refused `stale-id` until a `rules` listing re-establishes the space; names are always current."
        },
        "kind": { "enum": ["entry", "exit", "block", "if", "while", "for"], "description": "Selection (#531): only blocks of this kind." },
        "max": { "type": "integer", "minimum": 0, "description": "Selection (#531): report at most this many blocks; the response's `selection.withheld` counts what the bound dropped." }
      },
      "required": ["op", "rule"],
      "additionalProperties": false
    },
    "FindingsRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "findings" },
        "severity": { "enum": ["error", "warning", "info"] },
        "rule": { "type": "string" },
        "file": { "type": "string" },
        "max": { "type": "integer", "minimum": 0 }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "PersistentObjectsRequest": { "type": "object", "properties": { "op": { "const": "persistentObjects" } }, "required": ["op"], "additionalProperties": false },
    "LintRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "lint" },
        "severity": { "enum": ["error", "warning", "info"] },
        "rule": { "type": "string" },
        "file": { "type": "string" },
        "max": { "type": "integer", "minimum": 0 },
        "brief": { "type": "boolean", "default": false, "description": "Brief result form (#532): finding counts by severity, the highest-severity findings, and how to expand — the full result stays one option away." }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "LintRulesRequest": { "type": "object", "properties": { "op": { "const": "lintRules" } }, "required": ["op"], "additionalProperties": false },
    "CallGraphRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "callGraph" },
        "caller": { "type": "string", "description": "Selection (#531): only edges out of this declared rule name." },
        "callee": { "type": "string", "description": "Selection (#531): only edges into this declared subroutine name." },
        "max": { "type": "integer", "minimum": 0, "description": "Selection (#531): report at most this many edges; the response's `selection.withheld` counts what the bound dropped." }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "CostEstimateRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "costEstimate" },
        "severity": { "enum": ["error", "warning", "info"] },
        "rule": { "type": "string" },
        "file": { "type": "string" },
        "max": { "type": "integer", "minimum": 0 }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "TargetMetadataRequest": { "type": "object", "properties": { "op": { "const": "targetMetadata" } }, "required": ["op"], "additionalProperties": false },
    "ValidateEditTransactionRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "validateEditTransaction" },
        "sources": { "anyOf": [{ "$ref": "#/$defs/Sources" }, { "type": "null" }], "description": "Optional current texts for the edited sources; omitted or null reads the named files from disk (#472)." },
        "transaction": { "$ref": "#/$defs/EditTransaction" }
      },
      "required": ["op", "transaction"],
      "additionalProperties": false
    },
    "SemanticRenameRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "semanticRename" },
        "sources": { "anyOf": [{ "$ref": "#/$defs/Sources" }, { "type": "null" }], "description": "Optional current texts for the edited sources; omitted or null reads the named files from disk (#472)." },
        "target": { "$ref": "#/$defs/RenameTarget" }
      },
      "required": ["op", "target"],
      "additionalProperties": false
    },
    "ProviderSemanticRenameRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "providerSemanticRename" },
        "language_id": { "type": "string", "description": "The configured source provider's language id — `opy` for the shipped provider." },
        "documents": { "anyOf": [{ "$ref": "#/$defs/DocumentSet" }, { "type": "null" }], "description": "Optional: the caller-owned document set — must contain `position_document_uri`, the project entry document (the provider resolves the analyzable view from a supplied entry — a member file alone can refuse `rename.noSymbolAtPosition`), and every document the rename may edit. Omitted or null: the session's loaded project supplies the set — every member read from disk at version 0, keyed by `file://` URI." },
        "position_document_uri": { "type": "string", "description": "URI of the `documents` document holding the rename position." },
        "position": { "$ref": "#/$defs/Position" },
        "new_name": { "type": "string", "description": "The replacement identifier." },
        "project_root": { "type": ["string", "null"], "description": "Optional project root the provider resolves the project from." },
        "sources": { "anyOf": [{ "$ref": "#/$defs/Sources" }, { "type": "null" }], "description": "Optional URI → current text covering every document the provider's rename may edit (omitted or null defaults to each document's text); a returned edit into an unsupplied or mismatched source refuses `edit-unknown-source`/`edit-stale-source`." }
      },
      "required": ["op", "language_id", "position_document_uri", "position", "new_name"],
      "additionalProperties": false
    },
    "ProviderValidateEditRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "providerValidateEdit" },
        "language_id": { "type": "string", "description": "The configured source provider's language id — `opy` for the shipped provider." },
        "documents": { "anyOf": [{ "$ref": "#/$defs/DocumentSet" }, { "type": "null" }], "description": "Optional: the caller-owned document set — every `edits[].source` must be a key, and errors in any supplied document block the post-edit check. Omitted or null: the session's loaded project supplies the set — every member read from disk at version 0, keyed by `file://` URI." },
        "transaction": { "$ref": "#/$defs/EditTransaction" },
        "sources": { "anyOf": [{ "$ref": "#/$defs/Sources" }, { "type": "null" }], "description": "Optional URI → current text covering every `edits[].source` (omitted or null defaults to each document's text); each edit's `source_identity` verifies against it." },
        "project_root": { "type": ["string", "null"], "description": "Optional project root the provider resolves the project from." }
      },
      "required": ["op", "language_id", "transaction"],
      "additionalProperties": false
    },
    "LookupRequest": {
      "type": "object",
      "properties": {
        "op": { "const": "lookup" },
        "language": { "enum": ["workshop", "opy"] },
        "query": { "type": ["string", "null"] },
        "kind": {
          "enum": [
            "action", "value", "event", "enumMember", "enum", "setting",
            "parameter", "settingPath", "memberAction", "memberValue",
            "structural", "operator", null
          ]
        },
        "within": { "type": ["string", "null"] },
        "locale": { "type": ["string", "null"] },
        "limit": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 }
      },
      "required": ["op", "language"],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/ToolRequest"
}
